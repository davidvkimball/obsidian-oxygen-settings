{
  "compilerOptions": {
    "baseUrl": ".",
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "ESNext",
    "target": "ES6",
    "allowJs": true,
    "noImplicitAny": true,
    "moduleResolution": "node",
    "importHelpers": true,
    "isolatedModules": true,
    "strictNullChecks": true,
    "typeRoots": ["./node_modules/@types", "./src/types"],
    "lib": [
      "DOM",
      "ES2020"
    ]
  },
  "include": [
    "**/*.ts",
    "src/types/**/*.d.ts"
  ]
}
